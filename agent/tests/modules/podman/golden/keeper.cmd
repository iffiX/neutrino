@echo off
rem Generated by neutrino. Do not edit; change it on the hub instead.
cd /d "%USERPROFILE%"
set "CONTAINERS_MACHINE_PROVIDER=wsl"
set "PATH=C:\Program Files\Podman;%PATH%"
set "SOCKET=%TEMP%\podman\podman-machine-default-api.sock"
:loop
set "STATE="
for /f "usebackq delims=" %%s in (`podman machine inspect --format "{{.State}}" podman-machine-default 2^>nul`) do set "STATE=%%s"
if "%STATE%"=="" goto wait
if /i "%STATE%"=="running" goto wait
echo %date% %time% the machine is "%STATE%", starting it
if exist "%SOCKET%" del /q "%SOCKET%"
podman machine start podman-machine-default
if not errorlevel 1 goto wait
echo %date% %time% the start failed, stopping the machine and starting it once more
podman machine stop podman-machine-default
if exist "%SOCKET%" del /q "%SOCKET%"
podman machine start podman-machine-default
:wait
ping -n 31 127.0.0.1 >nul
goto loop
