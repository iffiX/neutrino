[Unit]
Description=CloudCLI for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
EnvironmentFile=/etc/neutrino/agent/cloudcli/%i.env
WorkingDirectory=~
ExecStart=/var/lib/neutrino/agent/cloudcli/node-v22.23.3-linux-x64/bin/node ${CLOUDCLI_SERVER}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
