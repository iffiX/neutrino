[Unit]
Description=Neutrino Hub agent
Documentation=https://github.com/iffiX/neutrino
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root: the agent installs packages, runs power actions, and steps down to
# accounts.
User=root
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/nagent run
Restart=always
RestartSec=10
# A child the kernel kills for want of memory ends that child alone; the
# agent keeps its socket and its shells.
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
