+/// Start the web client of an EasyTier console.
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_com_easytier_jni_EasyTierJNI_runWebClient(
+    mut env: JNIEnv,
+    _class: JClass,
+    config_server: JString,
+    hostname: JString,
+    state_dir: JString,
+    secure_mode: jni::sys::jboolean,
+) -> jint {
+    Lazy::force(&LOGGER_INIT);
+    let texts = [&config_server, &hostname, &state_dir].map(|value| jstring_to_cstring(&mut env, value));
+    let [Ok(config_server), Ok(hostname), Ok(state_dir)] = texts else {
+        throw_exception(&mut env, "Invalid web client argument");
+        return -1;
+    };
+    unsafe {
+        let result = run_web_client(
+            config_server.as_ptr(),
+            hostname.as_ptr(),
+            state_dir.as_ptr(),
+            secure_mode as std::ffi::c_int,
+        );
+        if result != 0
+            && let Some(error) = get_last_error()
+        {
+            throw_exception(&mut env, &error);
+        }
+        result
+    }
+}
+
+/// Stop the web client and the networks it started.
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_com_easytier_jni_EasyTierJNI_stopWebClient(mut env: JNIEnv, _class: JClass) -> jint {
+    Lazy::force(&LOGGER_INIT);
+    unsafe {
+        let result = stop_web_client();
+        if result != 0
+            && let Some(error) = get_last_error()
+        {
+            throw_exception(&mut env, &error);
+        }
+        result
+    }
+}
+
+/// Whether the web client holds a session with its console.
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_com_easytier_jni_EasyTierJNI_isWebClientConnected(
+    _env: JNIEnv,
+    _class: JClass,
+) -> jni::sys::jboolean {
+    unsafe { (is_web_client_connected() != 0) as jni::sys::jboolean }
+}
