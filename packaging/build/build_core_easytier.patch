+fn c_text(text: *const std::ffi::c_char) -> String {
+    unsafe {
+        assert!(!text.is_null());
+        std::ffi::CStr::from_ptr(text).to_string_lossy().into_owned()
+    }
+}
+
+/// # Safety
+/// Start the web client of an EasyTier console: the console pushes the networks it runs.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn run_web_client(
+    config_server: *const std::ffi::c_char,
+    hostname: *const std::ffi::c_char,
+    state_dir: *const std::ffi::c_char,
+    secure_mode: std::ffi::c_int,
+) -> std::ffi::c_int {
+    let config_server = c_text(config_server);
+    let hostname = c_text(hostname);
+    let state_dir = c_text(state_dir);
+    let mut held = WEB_CLIENT.lock().unwrap();
+    if held.is_some() {
+        set_error_msg("the web client is already running");
+        return -1;
+    }
+    let started = WEB_RUNTIME.block_on(easytier::web_client::run_web_client(
+        &config_server,
+        easytier::common::MachineIdOptions {
+            explicit_machine_id: None,
+            state_dir: Some(PathBuf::from(state_dir)),
+        },
+        Some(hostname),
+        secure_mode != 0,
+        INSTANCE_MANAGER.clone(),
+        None,
+    ));
+    match started {
+        Ok(client) => {
+            *held = Some(client);
+            0
+        }
+        Err(e) => {
+            set_error_msg(&format!("failed to start the web client: {}", e));
+            -1
+        }
+    }
+}
+
+/// Whether the web client holds a session with its console: 1 when it does, 0 when not.
+#[unsafe(no_mangle)]
+pub extern "C" fn is_web_client_connected() -> std::ffi::c_int {
+    let held = WEB_CLIENT.lock().unwrap();
+    match held.as_ref() {
+        Some(client) if client.is_connected() => 1,
+        _ => 0,
+    }
+}
+
+/// Stop the web client and every network it started.
+#[unsafe(no_mangle)]
+pub extern "C" fn stop_web_client() -> std::ffi::c_int {
+    let client = WEB_CLIENT.lock().unwrap().take();
+    WEB_RUNTIME.block_on(async move { drop(client) });
+    if let Err(e) = INSTANCE_MANAGER.retain_network_instance(Vec::new()) {
+        set_error_msg(&format!("failed to stop instances: {}", e));
+        return -1;
+    }
+    INSTANCE_NAME_ID_MAP.clear();
+    0
+}
