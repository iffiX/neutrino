@@ -0,0 +1,496 @@
+//! A C interface to one remote desktop session, for a host app with no Dart.
+//!
+//! The host calls `nd_init` once, `nd_start` per connection and `nd_close` to end it.
+//! Frames are drawn straight into the window handed over by `nd_attach_window`.
+//! The connection's progress and the remote clipboard's text come back through the callbacks
+//! given to `nd_start`; `nd_clipboard` sends the host's clipboard text to the remote machine.
+//! `nd_set_option` keeps a session option, such as the codec preference or the image quality,
+//! that every later `nd_start` applies to the peer's configuration.
+
+use crate::{
+    client::{Data, Interface},
+    flutter_ffi::EventToUI,
+    ui_session_interface::{io_loop, InvokeUiSession, Session},
+};
+use flutter_rust_bridge::{rust2dart::IntoIntoDart, IntoDart};
+use hbb_common::{
+    config, log,
+    message_proto::*,
+    rendezvous_proto::ConnType,
+};
+use std::{
+    collections::HashMap,
+    ffi::{CStr, CString},
+    os::raw::{c_char, c_int, c_void},
+    sync::{Arc, Mutex, RwLock},
+};
+
+/// The session logged in; frames follow.
+pub const ND_STATE_CONNECTED: c_int = 1;
+/// The machine refused the password.
+pub const ND_STATE_LOGIN_FAILED: c_int = 2;
+/// The connection ended; the text says why.
+pub const ND_STATE_CLOSED: c_int = 3;
+
+const WINDOW_FORMAT_RGBA_8888: i32 = 1;
+
+/// What the host is told, with the context pointer it gave.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct NdCallbacks {
+    pub context: *mut c_void,
+    pub on_state: Option<unsafe extern "C" fn(*mut c_void, c_int, *const c_char)>,
+    pub on_size: Option<unsafe extern "C" fn(*mut c_void, c_int, c_int)>,
+    pub on_clipboard: Option<unsafe extern "C" fn(*mut c_void, *const c_char)>,
+}
+
+unsafe impl Send for NdCallbacks {}
+unsafe impl Sync for NdCallbacks {}
+
+#[repr(C)]
+struct ANativeWindowBuffer {
+    width: i32,
+    height: i32,
+    stride: i32,
+    format: i32,
+    bits: *mut c_void,
+    reserved: [u32; 6],
+}
+
+#[link(name = "android")]
+extern "C" {
+    fn ANativeWindow_acquire(window: *mut c_void);
+    fn ANativeWindow_release(window: *mut c_void);
+    fn ANativeWindow_setBuffersGeometry(window: *mut c_void, w: i32, h: i32, format: i32) -> i32;
+    fn ANativeWindow_lock(
+        window: *mut c_void,
+        buffer: *mut ANativeWindowBuffer,
+        bounds: *mut c_void,
+    ) -> i32;
+    fn ANativeWindow_unlockAndPost(window: *mut c_void) -> i32;
+}
+
+struct NativeWindow {
+    window: usize,
+    size: (usize, usize),
+}
+
+lazy_static::lazy_static! {
+    static ref CALLBACKS: RwLock<Option<NdCallbacks>> = RwLock::new(None);
+    static ref WINDOW: Mutex<NativeWindow> = Mutex::new(NativeWindow { window: 0, size: (0, 0) });
+    static ref SESSION: RwLock<Option<Session<NativeHandler>>> = RwLock::new(None);
+    static ref MODIFIERS: Mutex<[bool; 4]> = Mutex::new([false; 4]);
+    static ref OPTIONS: Mutex<HashMap<String, String>> = Mutex::new(HashMap::new());
+}
+
+/// The peer option that names the image quality, kept in its own field of the peer config.
+const OPTION_IMAGE_QUALITY: &str = "image-quality";
+
+/// The session's link to the host: callbacks out and the window frames are drawn into.
+#[derive(Clone, Default)]
+pub struct NativeHandler {
+    origin: Arc<RwLock<(i32, i32)>>,
+    display: Arc<RwLock<i32>>,
+    frame_size: Arc<Mutex<(usize, usize)>>,
+    is_connected: Arc<Mutex<bool>>,
+}
+
+impl NativeHandler {
+    fn tell_state(&self, state: c_int, text: &str) {
+        let text = CString::new(text.replace('\0', "")).unwrap_or_default();
+        if let Some(callbacks) = *CALLBACKS.read().unwrap() {
+            if let Some(on_state) = callbacks.on_state {
+                unsafe { on_state(callbacks.context, state, text.as_ptr()) };
+            }
+        }
+    }
+
+    fn tell_clipboard(&self, text: &str) {
+        let text = CString::new(text.replace('\0', "")).unwrap_or_default();
+        if let Some(callbacks) = *CALLBACKS.read().unwrap() {
+            if let Some(on_clipboard) = callbacks.on_clipboard {
+                unsafe { on_clipboard(callbacks.context, text.as_ptr()) };
+            }
+        }
+    }
+
+    fn tell_size(&self, width: usize, height: usize) {
+        if let Some(callbacks) = *CALLBACKS.read().unwrap() {
+            if let Some(on_size) = callbacks.on_size {
+                unsafe { on_size(callbacks.context, width as c_int, height as c_int) };
+            }
+        }
+    }
+}
+
+fn draw(window: &mut NativeWindow, rgba: &scrap::ImageRgb) {
+    if window.window == 0 || rgba.w == 0 || rgba.h == 0 {
+        return;
+    }
+    let handle = window.window as *mut c_void;
+    if window.size != (rgba.w, rgba.h) {
+        unsafe {
+            ANativeWindow_setBuffersGeometry(
+                handle,
+                rgba.w as i32,
+                rgba.h as i32,
+                WINDOW_FORMAT_RGBA_8888,
+            )
+        };
+        window.size = (rgba.w, rgba.h);
+    }
+    let mut buffer = ANativeWindowBuffer {
+        width: 0,
+        height: 0,
+        stride: 0,
+        format: 0,
+        bits: std::ptr::null_mut(),
+        reserved: [0; 6],
+    };
+    if unsafe { ANativeWindow_lock(handle, &mut buffer, std::ptr::null_mut()) } != 0 {
+        return;
+    }
+    let source_stride = rgba.raw.len() / rgba.h;
+    let rows = rgba.h.min(buffer.height.max(0) as usize);
+    let columns = rgba.w.min(buffer.width.max(0) as usize);
+    let target_stride = buffer.stride.max(0) as usize * 4;
+    let target = unsafe {
+        std::slice::from_raw_parts_mut(buffer.bits as *mut u8, target_stride * rows)
+    };
+    for row in 0..rows {
+        let from = &rgba.raw[row * source_stride..row * source_stride + columns * 4];
+        let to = &mut target[row * target_stride..row * target_stride + columns * 4];
+        for (pixel, out) in from.chunks_exact(4).zip(to.chunks_exact_mut(4)) {
+            out[0] = pixel[2];
+            out[1] = pixel[1];
+            out[2] = pixel[0];
+            out[3] = 255;
+        }
+    }
+    unsafe { ANativeWindow_unlockAndPost(handle) };
+}
+
+fn is_password_box(msgtype: &str) -> bool {
+    msgtype.contains("password") || msgtype.contains("2fa") || msgtype.contains("login")
+}
+
+impl InvokeUiSession for NativeHandler {
+    fn set_cursor_data(&self, _cd: CursorData) {}
+    fn set_cursor_id(&self, _id: String) {}
+    fn set_cursor_position(&self, _cp: CursorPosition) {}
+    fn set_display(&self, x: i32, y: i32, _w: i32, _h: i32, _cursor_embedded: bool, _scale: f64) {
+        *self.origin.write().unwrap() = (x, y);
+    }
+    fn switch_display(&self, display: &SwitchDisplay) {
+        *self.origin.write().unwrap() = (display.x, display.y);
+        *self.display.write().unwrap() = display.display;
+    }
+    fn set_peer_info(&self, peer_info: &PeerInfo) {
+        let display = peer_info
+            .displays
+            .get(peer_info.current_display.max(0) as usize)
+            .or(peer_info.displays.first());
+        if let Some(display) = display {
+            *self.origin.write().unwrap() = (display.x, display.y);
+        }
+        *self.display.write().unwrap() = peer_info.current_display;
+        let mut is_connected = self.is_connected.lock().unwrap();
+        if !*is_connected {
+            *is_connected = true;
+            self.tell_state(ND_STATE_CONNECTED, "");
+        }
+    }
+    fn set_displays(&self, _displays: &Vec<DisplayInfo>) {}
+    fn set_platform_additions(&self, _data: &str) {}
+    fn on_connected(&self, _conn_type: ConnType) {}
