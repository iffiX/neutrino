{
  "name": "neutrino_docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vitepress dev --host 127.0.0.1",
    "build": "npm run typecheck && vitepress build",
    "preview": "vitepress preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pages": "python3 check_pages.py && python3 check_pages_en.py",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run pages"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.10.0",
    "image-size": "^2.0.4",
    "photoswipe": "^5.4.4",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.44"
  }
}
