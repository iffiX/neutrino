{
  "_comment": "VS Code in the browser: Microsoft's standalone CLI, whose serve-web the agent runs as each chosen account. Each file and digest is what update.code.visualstudio.com/api/update/<platform>/stable/latest answered for the tested build, and Microsoft's address is its one source. The Linux builds are the static Alpine ones; the server the CLI downloads needs glibc 2.28. The archive holds the one CLI, which lands directly in the module's own directory.",
  "name": "vscode",
  "title": "VS Code",
  "description": "VS Code in the browser, opened from a client through localhost",
  "publisher": "Microsoft",
  "license": "Microsoft Software License Terms",
  "corresponding_source": "https://github.com/microsoft/vscode/tree/{version}/cli",
  "uninstall_data": {
    "is_deleted": false,
    "text": {
      "en": "Each account's settings and extensions stay in its home folder.",
      "zh-CN": "每个账户的设置和扩展都留在它的主目录里。"
    }
  },
