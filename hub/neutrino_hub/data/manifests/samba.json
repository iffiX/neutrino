{
  "_comment": "The file share. On Linux the machine's own package manager installs Samba; Windows and macOS hold their own SMB server, so their entries are builtin. The shares, users and allowed subnets come from the hub's state for the device.",
  "name": "samba",
  "title": "File share",
  "description": "Serves shares over SMB from this machine",
  "publisher": "Samba Team",
  "platforms": {
    "linux-debian": {
      "runner": "samba",
      "install": {
        "method": "system",
        "params": {
          "version": "system",
          "packages": ["samba"],
          "verify": "smbd -V",
          "uninstall": {"packages": ["samba"], "post_uninstall": []}
        }
      }
    },
    "linux-rhel": {
      "runner": "samba",
      "install": {
        "method": "system",
        "params": {
          "version": "system",
          "packages": ["samba", "samba-client"],
          "verify": "smbd -V",
          "uninstall": {"packages": ["samba", "samba-client"], "post_uninstall": []}
        }
      }
    },
    "linux-arch": {
      "runner": "samba",
      "install": {
        "method": "system",
        "params": {
          "version": "system",
          "packages": ["samba"],
          "verify": "smbd -V",
          "uninstall": {"packages": ["samba"], "post_uninstall": []}
        }
      }
    },
    "windows": {"runner": "samba_native", "install": {"method": "builtin", "params": {}}},
    "darwin": {"runner": "samba_native", "install": {"method": "builtin", "params": {}}}
  }
}
