      "runner": "container",
      "requires": ["podman"],
      "install": {
        "method": "container",
        "params": {
          "version": "4.29.4",
          "releases": [{"kind": "oci", "sources": ["https://registry-1.docker.io"], "repository": "soulter/astrbot", "tag": "v{version}"}], "_releases_scan": "scan: allow",
          "artifacts": [
            {
              "name": "astrbot",
