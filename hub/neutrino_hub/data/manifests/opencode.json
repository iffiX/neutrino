      "install": {
        "method": "hub",
        "params": {
          "version": "1.19.5",
          "releases": [{"kind": "npm", "sources": ["https://registry.npmjs.org"], "package": "opencode-linux-x64-baseline"}],
          "artifacts": [
            {
              "name": "opencode",
              "kind": "tar_gz",
              "directory": "package",
