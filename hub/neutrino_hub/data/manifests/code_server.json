{
  "_comment": "code-server: Coder's standalone release, which carries its own Node.js, unpacked under code_server/release and run once per account. Its sources are the publisher's GitHub release, then the USTC mirror of the same files, which keeps the latest release alone. Each digest is the sha256 of the publisher's archive. The Linux builds need glibc 2.28 and GLIBCXX_3.4.21.",
  "name": "code_server",
  "title": "code-server",
  "description": "VS Code in the browser from code-server, one per account, opened from a client with a token",
  "publisher": "coder/code-server",
  "license": "MIT",
  "corresponding_source": "https://github.com/coder/code-server/tree/v{version}",
  "uninstall_data": {
    "is_deleted": false,
    "text": {
      "en": "Each account's code-server settings and extensions stay in its home folder.",
      "zh-CN": "每个账户的 code-server 设置和扩展都留在它的主目录里。"
    }
  },
  "platforms": {
    "linux-amd64": {
      "runner": "code_server",
      "install": {
        "method": "hub",
        "params": {
          "version": "4.140.0",
          "releases": [{"kind": "github", "sources": ["https://api.github.com"], "repository": "coder/code-server", "tag": "v{version}"}],
          "artifacts": [
            {
              "name": "release",
              "kind": "tar_gz",
              "directory": "release",
              "file": "code-server-{version}-linux-amd64.tar.gz",
              "digest": "sha256:864c5d01c808ade57e4d12c708717be7a187219fded60428f263b9e2da9f6b48", "_digest_scan": "scan: allow",
              "sources": ["https://github.com/coder/code-server/releases/download/v{version}/{file}", "https://mirrors.ustc.edu.cn/github-release/coder/code-server/v{version}/{file}"], "_sources_scan": "scan: allow"
            }
          ],
          "verify": "/var/lib/neutrino/agent/code_server/release/lib/node --version",
          "uninstall": {"post_uninstall": [], "is_data_kept": true}
        }
      }
    },
