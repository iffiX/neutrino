{
  "_comment": "The git server: the release binary its publisher builds, the same version for every system. On Linux the system's package manager installs git beside it; on macOS and Windows the module installs no git and refuses gitea_git_missing until the machine has one. The Windows build is the one that runs git, not the gogit build. Every digest is the one dl.gitea.com publishes in the release's .sha256 file, and dl.gitea.com and the GitHub release serve the same files.",
  "name": "gitea",
  "title": "Gitea",
  "description": "A private git server with its own web UI",
  "publisher": "go-gitea/gitea",
  "license": "MIT",
  "corresponding_source": "https://github.com/go-gitea/gitea/tree/v{version}",
  "is_data_forward_only": true,
  "platforms": {
    "linux-amd64": {
      "runner": "gitea",
      "install": {
        "method": "hub",
        "params": {
          "version": "1.27.3",
          "releases": [{"kind": "github", "sources": ["https://api.github.com"], "repository": "go-gitea/gitea", "tag": "v{version}"}],
          "artifacts": [
            {
              "name": "gitea",
              "kind": "binary",
              "file": "gitea-{version}-linux-amd64",
              "digest": "sha256:4da93c2c10b6980c359bcb86d5573ebfd7770e2e151756534edee24c8c12d971", "_digest_scan": "scan: allow",
              "sources": ["https://dl.gitea.com/gitea/{version}/{file}", "https://github.com/go-gitea/gitea/releases/download/v{version}/{file}"], "_sources_scan": "scan: allow"
            }
          ],
          "packages": ["git"],
          "verify": "/usr/local/bin/gitea --version",
          "uninstall": {"post_uninstall": [], "is_data_kept": true}
        }
      }
    },
