{
  "_comment": "The container engine. On Linux the machine's own package manager installs podman, and the declared containers become systemd units. On Windows and macOS the module's installer fetches Podman's installer and its machine image, which the agent keeps as the publisher's files, and the containers run inside one account's Podman machine; Windows amd64 also takes Microsoft's WSL msi (microsoft/WSL 3.0.3, MIT), pinned for every version, which Podman's msi does not install. Each machine image is podman-container-tools/podman-machine-os at Podman's own tag. Podman 6 publishes no macOS amd64 pkg, so darwin-amd64 tests 5.8.9. Every digest is the one GitHub's release API gives the asset, read on 2026-10-24; the msi and pkg digests are also those of the Podman release's own shasums file.",
  "name": "podman",
  "title": "Containers",
  "description": "Runs declared containers as systemd units",
  "publisher": "podman-container-tools/podman",
  "license": "Apache-2.0",
  "corresponding_source": "https://github.com/podman-container-tools/podman/tree/v{version}", "_source_scan": "scan: allow",
  "platforms": {
    "linux-debian": {
      "runner": "podman",
      "install": {
        "method": "system",
        "params": {
          "version": "system",
          "packages": ["podman", "runc"],
          "verify": "podman --version && runc --version",
          "uninstall": {"packages": ["podman"], "post_uninstall": []}
        }
      }
    },
