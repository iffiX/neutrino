{
  "_comment": "Hermes WebUI (nesquena/hermes-webui, MIT) and Hermes Agent (NousResearch/hermes-agent, MIT, source at https://github.com/NousResearch/hermes-agent/tree/v2026.9.24), two images run as one tested pair on the Containers module. The module's version is the webui's; the agent image v2026.9.24 is pinned beside it. Each digest is the publisher's OCI index digest, covering amd64 and arm64; the webui's mirrors serve the same index, and the agent's docker.io source is reached through the docker.io mirrors the Containers module names. No releases: the pair is the one version a machine installs. The containers' tools fetch Python packages from the pypi source set.", "_source_scan": "scan: allow",
  "name": "hermes_webui",
  "title": "Hermes WebUI",
  "description": "A web page for Hermes Agent, Nous Research's AI agent, opened from a client with a token",
  "publisher": "nesquena/hermes-webui and NousResearch/hermes-agent",
  "license": "MIT",
  "corresponding_source": "https://github.com/nesquena/hermes-webui/tree/v{version}", "_corresponding_scan": "scan: allow",
  "uninstall_data": {
    "is_deleted": true,
    "text": {
      "en": "The conversations, settings and workspace files are deleted and cannot be recovered.",
      "zh-CN": "对话、设置和工作区里的文件都会删除，无法恢复。"
    }
  },
