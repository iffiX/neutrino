{
  "_comment": "Remote desktop. Linux builds come from AnyDesk's apt pool, which carries every architecture under one naming scheme; the Windows and macOS downloads are the vendor's evergreen links. No RHEL entry until one is verified — an unsupported platform is offered nothing rather than a guess.",
  "name": "anydesk",
  "title": "AnyDesk",
  "kind": "package",
  "description": "Remote desktop, reachable by AnyDesk address",
  "platforms": {
    "linux-debian-amd64": {
      "url": "https://deb.anydesk.com/pool/main/a/anydesk/anydesk_8.0.4_amd64.deb",
      "package_kind": "deb",
      "uninstall": "apt-get remove -y anydesk"
    },
    "linux-debian-arm64": {
      "url": "https://deb.anydesk.com/pool/main/a/anydesk/anydesk_8.0.4_arm64.deb",
      "package_kind": "deb",
      "uninstall": "apt-get remove -y anydesk"
    },
    "linux-debian-armhf": {
      "url": "https://deb.anydesk.com/pool/main/a/anydesk/anydesk_6.3.0_armhf.deb",
      "package_kind": "deb",
      "uninstall": "apt-get remove -y anydesk"
    },
    "windows-amd64": {
      "url": "https://download.anydesk.com/AnyDesk.exe",
      "package_kind": "exe",
      "install_args": [
        "--install",
        "C:\\Program Files (x86)\\AnyDesk",
        "--start-with-win",
        "--silent"
      ],
      "uninstall": "\"C:\\\\Program Files (x86)\\\\AnyDesk\\\\AnyDesk.exe\" --remove --silent"
    },
    "darwin": {
      "url": "https://download.anydesk.com/anydesk.dmg",
      "package_kind": "dmg",
      "app_name": "AnyDesk.app",
      "uninstall": "rm -rf /Applications/AnyDesk.app"
    }
  },
  "verify": {
    "linux": "which anydesk",
    "windows": "powershell -NoProfile -Command \"Test-Path 'C:\\Program Files (x86)\\AnyDesk\\AnyDesk.exe'\"",
    "darwin": "test -d /Applications/AnyDesk.app"
  }
}
