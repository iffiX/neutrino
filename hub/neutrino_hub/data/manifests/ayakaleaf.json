{
  "_comment": "Ayakaleaf (ayaka-notes/ayakaleaf-pro, AGPL-3.0), Overleaf Community Edition with the Server Pro features its publisher adds, run as three images on the Containers module: the app, MongoDB (SSPL-1.0) and Redis (RSALv2 or SSPL-1.0). The module's version is the app's: the oci feed lists the app image's dotted tags, and a version other than the tested one takes the app digest the registry gives its tag, while MongoDB and Redis keep their own digests for every version. Each digest is the publisher's OCI index digest, covering amd64 and arm64; the app's mirrors serve the same index, and the docker.io images are reached through the docker.io mirrors the Containers module names. The first start's TeX step reads the ctan set.", "_source_scan": "scan: allow",
  "name": "ayakaleaf",
  "title": "Ayakaleaf",
  "description": "LaTeX papers written and compiled in Ayakaleaf, Overleaf with its Server Pro features, opened from a client with a token",
  "publisher": "ayaka-notes/ayakaleaf-pro",
  "license": "AGPL-3.0",
  "corresponding_source": "https://github.com/ayaka-notes/ayakaleaf-pro/tree/pro-v{version}", "_corresponding_scan": "scan: allow",
  "uninstall_data": {"is_deleted": true, "text": {"en": "The papers and projects are deleted and cannot be recovered.", "zh-CN": "论文和项目都会删除，无法恢复。"}},
