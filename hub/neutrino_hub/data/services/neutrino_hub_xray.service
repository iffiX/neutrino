[Unit]
Description=Neutrino proxy core (Xray)
Documentation=https://xtls.github.io
After=network.target nss-lookup.target neutrino_hub_router.service
Wants=neutrino_hub_router.service

[Service]
Type=simple
# Unprivileged, with the two capabilities transparent proxying needs: TPROXY
# sockets and stamping egress with a firewall mark.
User=xray
Group=xray
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# Through the hub rather than straight at the binary: the config path and the
# database directory are the hub's to know, and a unit repeating them is a
# second copy to keep in step. It replaces itself with xray, so this account
# and the capabilities above carry into the binary and nothing lingers between
# systemd and the daemon it is watching.
ExecStart=@PYTHON@ -m neutrino_hub.cli.entry run --only-xray
Restart=on-failure
RestartSec=5
# A configuration xray rejects exits 23, and restarting cannot fix it.
RestartPreventExitStatus=23
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
