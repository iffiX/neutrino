[Unit]
Description=Neutrino Hub lease client on %i
Documentation=file://@REPO_ROOT@/docs/standard/design/network.md
# The firewall has to know about the interface before it carries anything, and
# a radio has to have joined a network before there is anyone to ask.
After=network-pre.target neutrino_hub_router.service neutrino_hub_supplicant@%i.service
Wants=network-pre.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONPATH=@REPO_ROOT@
ExecStart=@PYTHON@ -m neutrino_hub.cli.entry run --only-dhcpcd --interface %i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
