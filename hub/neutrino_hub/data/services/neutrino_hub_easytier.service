[Unit]
Description=Neutrino remote access (EasyTier)
Documentation=https://easytier.cn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root: the engine opens the tunnel device and edits the routes.
User=root
# The engine the package carries, on the network file the panel renders. The
# panel's apply replaces this line with a root-only drop-in in
# neutrino_hub_easytier.service.d/: the network file in manual mode, the
# console address with its token in console mode.
ExecStart=/opt/neutrino/hub/bin/easytier-core -c /var/lib/neutrino/hub/generated/easytier.toml --rpc-portal 127.0.0.1:15888
Restart=always
RestartSec=5
# A node keeps a socket per peer and per attempt; the vendor's own guidance
# for anything that answers other machines is to lift the default 1024.
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
