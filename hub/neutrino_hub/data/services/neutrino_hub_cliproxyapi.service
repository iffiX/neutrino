[Unit]
Description=Neutrino AI gateway (CLIProxyAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root, because the rendered configuration under /var/lib/neutrino/generated is
# root-only — it carries every provider key.
User=root
# The hub knows where its own state and rendered config live, and makes the
# directory before it replaces itself with the gateway.
ExecStart=@PYTHON@ -m neutrino_hub.cli.entry run --only-cliproxyapi
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
