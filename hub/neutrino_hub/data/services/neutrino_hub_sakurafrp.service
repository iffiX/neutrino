[Unit]
Description=Neutrino way in through a SakuraFrp node (frpc)
After=network-online.target
Wants=network-online.target
# The panel's apply writes the file while SakuraFrp is on and a tunnel is
# picked, and deletes it otherwise.
ConditionPathExists=/var/lib/neutrino/hub/sakurafrp/frpc.toml

[Service]
Type=simple
# Root: the file under the state root holds the account's token.
User=root
ExecStart=/opt/neutrino/hub/bin/frpc -c /var/lib/neutrino/hub/sakurafrp/frpc.toml
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
