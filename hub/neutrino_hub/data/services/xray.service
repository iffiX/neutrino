[Unit]
Description=Neutrino proxy core (Xray)
Documentation=https://xtls.github.io
After=network.target nss-lookup.target neutrino_router.service
Wants=neutrino_router.service

[Service]
Type=simple
# Unprivileged, with the two capabilities transparent proxying needs: TPROXY
# sockets and stamping egress with a firewall mark.
User=xray
Group=xray
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# xray reads its databases from beside its own binary unless told otherwise,
# and the hub keeps them under the state root instead. %S is /var/lib for a
# system unit.
Environment=XRAY_LOCATION_ASSET=%S/neutrino/geodata
ExecStart=/opt/neutrino/bin/xray run -config /var/lib/neutrino/generated/xray_config.json
Restart=on-failure
RestartSec=5
# A configuration xray rejects exits 23, and restarting cannot fix it.
RestartPreventExitStatus=23
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
