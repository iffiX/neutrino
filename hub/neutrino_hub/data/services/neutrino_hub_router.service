[Unit]
Description=Neutrino Hub routing state (forwarding, policy route, nftables)
Documentation=file://@REPO_ROOT@/docs/standard/misc/config.md
After=network-pre.target
Wants=network-pre.target
Before=neutrino_hub_xray.service neutrino_hub_dnsmasq.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONPATH=@REPO_ROOT@
ExecStart=@PYTHON@ -m neutrino_hub.cli.entry apply --only router
ExecStop=-/usr/sbin/nft delete table inet neutrino
ExecStop=-/usr/sbin/ip rule del fwmark 0x1 lookup 100

[Install]
WantedBy=multi-user.target
