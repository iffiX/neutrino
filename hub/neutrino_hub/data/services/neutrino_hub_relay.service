[Unit]
Description=Neutrino way in through a server you own (reverse SSH forward)
Documentation=https://neutrino.beyond-infinity.top/hub/relay.html
After=network-online.target
Wants=network-online.target
# The key file, or the password file with a login, is written by the panel's
# apply while the relay is on; either one lets the unit start.
ConditionPathExists=|/var/lib/neutrino/hub/relay/key
ConditionPathExists=|/var/lib/neutrino/hub/relay/password

[Service]
Type=simple
# Root: the key and password files under the state root are root's alone.
User=root
# The panel's apply replaces this line with the drop-in
# neutrino_hub_relay.service.d/arguments.conf, rendered from
# config/overlay/relay.json.
ExecStart=/usr/bin/ssh -V
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
