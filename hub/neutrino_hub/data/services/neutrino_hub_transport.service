[Unit]
Description=Neutrino Hub transport: the agent port
Documentation=file://@REPO_ROOT@/skills/core-code-author/design/protocol.md
After=network.target

[Service]
Type=simple
# Its own account: the process every stranger's bytes reach first holds no
# root. The hub's Python decides over the local channel.
User=neutrino_transport
Group=neutrino_transport
ExecStart=@TRANSPORT@ hub --config @STATE_ROOT@/generated/transport.json --key-dir @CONFIG_DIR@/transport --secret-file @STATE_ROOT@/transport/control_secret
Restart=always
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@CONFIG_DIR@/transport @STATE_ROOT@/transport @RUNTIME_ROOT@/transport
RestrictRealtime=yes
LockPersonality=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# For an agent port under 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
