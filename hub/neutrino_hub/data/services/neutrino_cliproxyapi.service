[Unit]
Description=Neutrino AI gateway (CLIProxyAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root, because the rendered configuration under /var/lib/neutrino/generated is
# root-only — it carries every provider key.
User=root
WorkingDirectory=/var/lib/neutrino/cliproxyapi
ExecStart=/opt/neutrino/bin/cli-proxy-api --config /var/lib/neutrino/generated/cliproxyapi.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
