# --- Real config (secrets). Keep the committed *.example.json siblings. ---
config/xray/nodes.json
config/xray/routing.json
config/router/network.json
config/web/settings.json
config/samba/samba.json
config/gitea/gitea.json
config/podman/podman.json
config/gitea/secrets.json
config/devices/devices.json
config/credentials/ai_providers.json
config/cliproxy/cliproxy.json
config/devices/packages/
config/devices/known_hosts
config/credentials/ssh_keys/*
