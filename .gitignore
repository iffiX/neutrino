# --- Notes about this machine, not about the project ---
# The working copy's own memory: what has been decided and what is deliberately
# not done yet, alongside the maintainer's address and the layout of the box it
# runs on. Kept beside the code and out of the history.
docs/memory.md

# The appliance a working copy runs against under `--dev`. Deleting it is how
# a development hub goes back to nothing; design/install_and_dev.md.
hub_dev_root/

# Built into the hub package in the container; never committed.
hub/neutrino_hub/data/agent_package/
agent_dev_root/

# --- Python ---
# Stamped in by the packaging build, never committed.
hub/neutrino_hub/_version.py
agent/neutrino_agent/_version.py
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Frontend ---
hub/build/
hub/frontend/dist/
hub/frontend/node_modules/
hub/frontend/.vite/
hub/frontend/*.tsbuildinfo
hub/neutrino_hub/data/frontend/

# --- Build products ---
/dist/

# --- Generated / local ---
/etc/neutrino/
*.log
.DS_Store

# --- Built agent packages ---
# The tarball the hub uploads to a device, built from agent/ by
# scripts/build_package. Never committed: it is a build product, and the
# vendor software a device needs is fetched by the agent itself from the
# manifests, on the device's own network.
